{
  "name": "aidlc-viewer",
  "displayName": "AIDLC-VIEWER",
  "description": "Watch AIDLC workflow folders, visualize AI-DLC progress, and edit Markdown artifacts in a split editor/preview viewer with zoom.",
  "version": "0.0.8",
  "publisher": "jikjeong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jikang-jeong/aidlc-viewer-extension.git"
  },
  "homepage": "https://github.com/jikang-jeong/aidlc-viewer-extension",
  "bugs": {
    "url": "https://github.com/jikang-jeong/aidlc-viewer-extension/issues"
  },
  "icon": "media/marketplace-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "aidlc",
    "ai-dlc",
    "workflow",
    "markdown",
    "viewer",
    "sdlc"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:markdownWatchViewer.selectFolder",
    "onCommand:markdownWatchViewer.showHelp",
    "onView:markdownWatchViewer.tree"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownWatchViewer.selectFolder",
        "title": "AIDLC-VIEWER: Open Workspace",
        "shortTitle": "Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "markdownWatchViewer.refresh",
        "title": "AIDLC-VIEWER: Refresh",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownWatchViewer.showHelp",
        "title": "AIDLC-VIEWER: Help / Guide",
        "shortTitle": "Help",
        "icon": "$(question)"
      },
      {
        "command": "markdownWatchViewer.openFile",
        "title": "AIDLC-VIEWER: Open File"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownWatchViewer",
          "title": "AIDLC",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "markdownWatchViewer": [
        {
          "id": "markdownWatchViewer.tree",
          "name": "VIEWER"
        }
      ]
    },
    "configurationDefaults": {
      "[markdownWatchViewer.tree]": {
        "workbench.tree.indent": 20
      },
      "workbench.tree.indent": 20,
      "workbench.tree.renderIndentGuides": "always"
    },
    "viewsWelcome": [
      {
        "view": "markdownWatchViewer.tree",
        "contents": "No AI-DLC folder is being watched yet.\n\n[Select AI-DLC Folder](command:markdownWatchViewer.selectFolder)\n\nAI-DLC generates artifacts under `inception/`, `construction/`, and `operations/`. Pick the root folder where these are (or will be) created.\n\n[Open AI-DLC Guide](command:markdownWatchViewer.showHelp)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markdownWatchViewer.selectFolder",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@1"
        },
        {
          "command": "markdownWatchViewer.refresh",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@2"
        },
        {
          "command": "markdownWatchViewer.showHelp",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownWatchViewer.openFile",
          "when": "view == markdownWatchViewer.tree && viewItem == markdownFile",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  }
}
