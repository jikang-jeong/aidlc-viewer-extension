{
  "name": "aidlc-viewer",
  "displayName": "AIDLC-VIEWER",
  "description": "Companion tool for AWS AI-DLC. Sets the workflow up in one click, and shows where it has got to.",
  "version": "0.0.26",
  "publisher": "jikjeong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jikang-jeong/aidlc-viewer-extension.git"
  },
  "homepage": "https://github.com/jikang-jeong/aidlc-viewer-extension",
  "bugs": {
    "url": "https://github.com/jikang-jeong/aidlc-viewer-extension/issues"
  },
  "icon": "media/marketplace-icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "aidlc",
    "ai-dlc",
    "aws",
    "workflow",
    "agent",
    "markdown",
    "viewer",
    "sdlc",
    "kiro"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:markdownWatchViewer.selectFolder",
    "onCommand:markdownWatchViewer.showHelp",
    "onCommand:markdownWatchViewer.setupRules",
    "onView:markdownWatchViewer.tree"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownWatchViewer.selectFolder",
        "title": "AIDLC-VIEWER: Open Workspace",
        "shortTitle": "Workspace",
        "icon": "$(folder-opened)"
      },
      {
        "command": "markdownWatchViewer.refresh",
        "title": "AIDLC-VIEWER: Refresh",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownWatchViewer.showHelp",
        "title": "AIDLC-VIEWER: Help / Guide",
        "shortTitle": "Help",
        "icon": "$(question)"
      },
      {
        "command": "markdownWatchViewer.setupRules",
        "title": "AIDLC-VIEWER: Set up AI-DLC Rules",
        "shortTitle": "Setup Rules",
        "icon": "$(cloud-download)"
      },
      {
        "command": "markdownWatchViewer.checkV2",
        "title": "AIDLC-VIEWER: Check AI-DLC v2 setup"
      },
      {
        "command": "markdownWatchViewer.removeV2",
        "title": "AIDLC-VIEWER: Remove AI-DLC v2"
      },
      {
        "command": "markdownWatchViewer.openFile",
        "title": "AIDLC-VIEWER: Open File"
      },
      {
        "command": "markdownWatchViewer.openInTextEditor",
        "title": "Open in Text Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownWatchViewer.showCredits",
        "title": "AI-DLC: Usage",
        "icon": "$(graph)"
      },
      {
        "command": "markdownWatchViewer.showWaiting",
        "title": "AI-DLC: Waiting for you"
      },
      {
        "command": "markdownWatchViewer.showEngineRecords",
        "title": "AI-DLC: v2 Engine Log"
      },
      {
        "command": "markdownWatchViewer.openChatToStart",
        "title": "AI-DLC: Open chat to start"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownWatchViewer",
          "title": "AI-DLC Viewer",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "markdownWatchViewer": [
        {
          "id": "markdownWatchViewer.tree",
          "name": "VIEWER"
        }
      ]
    },
    "configurationDefaults": {
      "[markdownWatchViewer.tree]": {
        "workbench.tree.indent": 20
      },
      "workbench.tree.indent": 20,
      "workbench.tree.renderIndentGuides": "always"
    },
    "viewsWelcome": [
      {
        "view": "markdownWatchViewer.tree",
        "contents": "No AI-DLC folder is being watched yet.\n\n[Select AI-DLC Folder](command:markdownWatchViewer.selectFolder)\n\nAI-DLC generates artifacts under `inception/`, `construction/`, and `operations/`. Pick the root folder where these are (or will be) created.\n\n[Open AI-DLC Viewer Guide](command:markdownWatchViewer.showHelp)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markdownWatchViewer.selectFolder",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@1"
        },
        {
          "command": "markdownWatchViewer.refresh",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@2"
        },
        {
          "command": "markdownWatchViewer.setupRules",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@3"
        },
        {
          "command": "markdownWatchViewer.showHelp",
          "when": "view == markdownWatchViewer.tree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownWatchViewer.openFile",
          "when": "view == markdownWatchViewer.tree && viewItem == markdownFile",
          "group": "inline"
        },
        {
          "command": "markdownWatchViewer.openInTextEditor",
          "when": "view == markdownWatchViewer.tree && viewItem == markdownFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownWatchViewer.checkV2"
        },
        {
          "command": "markdownWatchViewer.removeV2",
          "when": "aidlcViewer.v2Detected"
        },
        {
          "command": "markdownWatchViewer.showWaiting",
          "when": "aidlcViewer.v2Detected"
        },
        {
          "command": "markdownWatchViewer.showEngineRecords",
          "when": "aidlcViewer.v2Detected"
        },
        {
          "command": "markdownWatchViewer.openChatToStart",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check src/extension.js",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "npm run check && npm test",
    "probe": "node tools/aidlc-probe.js",
    "package": "npx --yes @vscode/vsce@2.15.0 package --no-dependencies --no-rewrite-relative-links",
    "regress": "node tools/aidlc-regress.js",
    "regress:update": "node tools/aidlc-regress.js --update"
  }
}
